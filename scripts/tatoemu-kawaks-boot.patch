+// kof2003 / mslug5 / mslug5nd PVC palette + bank RAM at 0x2fe000.
+class PvcMemory : public MemoryHijacker {
+public:
+    PvcMemory(Memory* memory, u8 bankBit);
+
+    bool read8(u32 address, u8& ret) override;
+    bool read16(u32 address, u16& ret) override;
+    bool write8(u32 address, u8 value) override;
+    bool write16(u32 address, u16 value) override;
+
+private:
+    void palette01();
+    void palette02();
+    void bankswitch();
+    void afterWrite(u32 address);
+
+    Memory* m_memory;
+    u8 m_bankBit;
+    u8 m_ram[0x2000];
+};
