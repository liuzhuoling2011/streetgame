+// ============================================================================
+// Metal Slug 3 SMA
+// ============================================================================
+Mslug3SmaMemory::Mslug3SmaMemory(Memory* memory) : m_memory(memory) {}
+
+bool Mslug3SmaMemory::read8(u32 address, u8& ret) {
+    if (address == 0x2FE446) { ret = 0x9A; return true; }
+    if (address == 0x2FE447) { ret = 0x37; return true; }
+    return false;
+}
+
+bool Mslug3SmaMemory::read16(u32 address, u16& ret) {
+    if (address == 0x2FE446) { ret = 0x9A37; return true; }
+    return false;
+}
+
+bool Mslug3SmaMemory::write16(u32 address, u16 value) {
+    // SMA replaces the normal bankswitch handler for 0x2FFC00-0x2FFFFF.
+    if (address < 0x2FFC00 || address > 0x2FFFFF) return false;
+    if (address == 0x2FFFE4) {
+        static const u32 bankOffset[64] = {
+            0x100000, 0x120000, 0x140000, 0x160000,
+            0x170000, 0x190000, 0x1b0000, 0x1d0000,
+            0x1e0000, 0x1f0000, 0x220000, 0x230000,
+            0x240000, 0x250000, 0x280000, 0x290000,
+            0x2a0000, 0x2b0000, 0x2e0000, 0x2f0000,
+            0x300000, 0x310000, 0x340000, 0x350000,
+            0x360000, 0x370000, 0x3a0000, 0x3b0000,
+            0x3c0000, 0x3d0000, 0x400000, 0x410000,
+            0x420000, 0x430000, 0x460000, 0x470000,
+            0x480000, 0x490000, 0x4c0000, 0x4d0000,
+            0x500000, 0x510000, 0x540000, 0x550000,
+            0x560000, 0x570000, 0x5a0000, 0x5b0000,
+            0x5c0000,
+        };
+        u32 index =
+            (((value >> 14) & 1) << 0) +
+            (((value >> 12) & 1) << 1) +
+            (((value >> 15) & 1) << 2) +
+            (((value >>  6) & 1) << 3) +
+            (((value >>  3) & 1) << 4) +
+            (((value >>  9) & 1) << 5);
+        u32 bank = index < 49 ? bankOffset[index] : 0x100000;
+        m_memory->setProgramRomBank(bank);
+    }
+    return true;
+}
+
+// ============================================================================
+// PVC (kof2003, mslug5, mslug5nd)
+// ============================================================================
+PvcMemory::PvcMemory(Memory* memory, u8 bankBit)
+    : m_memory(memory)
+    , m_bankBit(bankBit) {
+    std::memset(m_ram, 0, sizeof(m_ram));
+}
+
+void PvcMemory::palette01() {
+    u8 b1 = m_ram[0x1fe1];
+    u8 b2 = m_ram[0x1fe0];
+    m_ram[0x1fe2] = ((b2 & 0xf) << 1) | ((b1 >> 4) & 1);
+    m_ram[0x1fe3] = (((b2 >> 4) & 0xf) << 1) | ((b1 >> 5) & 1);
+    m_ram[0x1fe4] = ((b1 & 0xf) << 1) | ((b1 >> 6) & 1);
+    m_ram[0x1fe5] = b1 >> 7;
+}
+
+void PvcMemory::palette02() {
+    u8 b1 = m_ram[0x1fe9];
+    u8 b2 = m_ram[0x1fe8];
+    u8 b3 = m_ram[0x1feb];
+    u8 b4 = m_ram[0x1fea];
+    m_ram[0x1fec] = (b2 >> 1) | ((b1 >> 1) << 4);
+    m_ram[0x1fed] = (b4 >> 1) | ((b2 & 1) << 4) | ((b1 & 1) << 5) | ((b4 & 1) << 6) | ((b3 & 1) << 7);
+}
+
+void PvcMemory::bankswitch() {
+    u32 bank = (static_cast<u32>(m_ram[0x1ff3]) << 16)
+        | (static_cast<u32>(m_ram[0x1ff2]) << 8)
+        | m_ram[0x1ff1];
+    bank += (m_bankBit & 0x10) << 16;
+    m_memory->setProgramRomBank(bank);
+    m_ram[0x1ff0] = 0xa0;
+    m_ram[0x1ff1] &= 0xfe;
+    m_ram[0x1ff3] &= 0x7f;
+}
+
+void PvcMemory::afterWrite(u32 address) {
+    if (address >= 0x2fffe0 && address <= 0x2fffe1) palette01();
+    else if (address >= 0x2fffe8 && address <= 0x2fffeb) palette02();
+    else if (address >= 0x2ffff0 && address <= 0x2ffff3) bankswitch();
+}
+
+bool PvcMemory::read8(u32 address, u8& ret) {
+    if (address < 0x2fe000 || address > 0x2fffff) return false;
+    ret = m_ram[(address & 0x1fff) ^ 1];
+    return true;
+}
+
+bool PvcMemory::read16(u32 address, u16& ret) {
+    if (address < 0x2fe000 || address > 0x2fffff) return false;
+    u32 off = address & 0x1ffe;
+    ret = static_cast<u16>(m_ram[off + 1] << 8) | m_ram[off];
+    return true;
+}
+
+bool PvcMemory::write8(u32 address, u8 value) {
+    if (address < 0x2fe000 || address > 0x2fffff) return false;
+    m_ram[(address & 0x1fff) ^ 1] = value;
+    afterWrite(address);
+    return true;
+}
+
+bool PvcMemory::write16(u32 address, u16 value) {
+    if (address < 0x2fe000 || address > 0x2fffff) return false;
+    u32 off = address & 0x1ffe;
+    m_ram[off] = static_cast<u8>(value);
+    m_ram[off + 1] = static_cast<u8>(value >> 8);
+    afterWrite(address);
+    return true;
+}
+
 } // namespace neogeo
