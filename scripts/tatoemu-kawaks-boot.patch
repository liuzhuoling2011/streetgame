diff --git a/emulators/neogeo/bitswap.h b/emulators/neogeo/bitswap.h
new file mode 100644
index 0000000..23fb913
--- /dev/null
+++ b/emulators/neogeo/bitswap.h
@@ -0,0 +1,35 @@
+#pragma once
+#include "../types.h"
+
+namespace neogeo {
+
+inline u32 bitAt(u32 value, int bit) { return (value >> bit) & 1u; }
+
+inline u32 bitswap08(u32 v, int b7, int b6, int b5, int b4, int b3, int b2, int b1, int b0) {
+    return (bitAt(v, b7) << 7) | (bitAt(v, b6) << 6) | (bitAt(v, b5) << 5) | (bitAt(v, b4) << 4)
+        | (bitAt(v, b3) << 3) | (bitAt(v, b2) << 2) | (bitAt(v, b1) << 1) | bitAt(v, b0);
+}
+
+inline u32 bitswap16(u32 v,
+    int b15, int b14, int b13, int b12, int b11, int b10, int b9, int b8,
+    int b7, int b6, int b5, int b4, int b3, int b2, int b1, int b0) {
+    return (bitAt(v, b15) << 15) | (bitAt(v, b14) << 14) | (bitAt(v, b13) << 13) | (bitAt(v, b12) << 12)
+        | (bitAt(v, b11) << 11) | (bitAt(v, b10) << 10) | (bitAt(v, b9) << 9) | (bitAt(v, b8) << 8)
+        | (bitAt(v, b7) << 7) | (bitAt(v, b6) << 6) | (bitAt(v, b5) << 5) | (bitAt(v, b4) << 4)
+        | (bitAt(v, b3) << 3) | (bitAt(v, b2) << 2) | (bitAt(v, b1) << 1) | bitAt(v, b0);
+}
+
+inline u32 bitswap24(u32 v,
+    int b23, int b22, int b21, int b20, int b19, int b18, int b17, int b16,
+    int b15, int b14, int b13, int b12, int b11, int b10, int b9, int b8,
+    int b7, int b6, int b5, int b4, int b3, int b2, int b1, int b0) {
+    return (bitAt(v, b23) << 23) | (bitAt(v, b22) << 22) | (bitAt(v, b21) << 21) | (bitAt(v, b20) << 20)
+        | (bitAt(v, b19) << 19) | (bitAt(v, b18) << 18) | (bitAt(v, b17) << 17) | (bitAt(v, b16) << 16)
+        | bitswap16(v, b15, b14, b13, b12, b11, b10, b9, b8, b7, b6, b5, b4, b3, b2, b1, b0);
+}
+
+} // namespace neogeo
+
+#define BITSWAP08(v, a, b, c, d, e, f, g, h) (::neogeo::bitswap08((v), (a), (b), (c), (d), (e), (f), (g), (h)))
+#define BITSWAP16(v, a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p) (::neogeo::bitswap16((v),(a),(b),(c),(d),(e),(f),(g),(h),(i),(j),(k),(l),(m),(n),(o),(p)))
+#define BITSWAP24(v, a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,w,x,y) (::neogeo::bitswap24((v),(a),(b),(c),(d),(e),(f),(g),(h),(i),(j),(k),(l),(m),(n),(o),(p),(q),(r),(s),(t),(u),(w),(x),(y)))
