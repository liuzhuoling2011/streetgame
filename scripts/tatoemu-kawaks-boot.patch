diff --git a/emulators/neogeo/decrypt.cpp b/emulators/neogeo/decrypt.cpp
new file mode 100644
index 0000000..da0dcd3
--- /dev/null
+++ b/emulators/neogeo/decrypt.cpp
@@ -0,0 +1,191 @@
+// Program and sample descramblers ported from FBNeo d_neogeo.cpp.
+// CMC graphics / M1 live in cmc.cpp. These routines run on the file-order
+// buffer FBNeo keeps in Neo68KROMActive (little-endian host, no byteswap).
+#include "decrypt.h"
+#include "bitswap.h"
+#include <cstring>
+#include <string>
+#include <string_view>
+
+namespace neogeo {
+
+static u16 load16(const u8* p) {
+    u16 value;
+    std::memcpy(&value, p, sizeof(value));
+    return value;
+}
+
+static void store16(u8* p, u16 value) {
+    std::memcpy(p, &value, sizeof(value));
+}
+
+static u16 readUnaligned16(const u8* p) {
+    return static_cast<u16>(p[0]) | (static_cast<u16>(p[1]) << 8);
+}
+
+static void writeUnaligned16(u8* p, u16 value) {
+    p[0] = static_cast<u8>(value);
+    p[1] = static_cast<u8>(value >> 8);
+}
+
+static void pcm2DecryptP(std::vector<u8>& rom) {
+    if (rom.size() < 0x500000) {
+        log_error("PCM2 P decrypt needs 5MB of program ROM, have %zu", rom.size());
+        return;
+    }
+    std::vector<u8> temp(rom.begin() + 0x100000, rom.begin() + 0x500000);
+    for (s32 i = 0; i < 4; i++) {
+        s32 srcA = (((((i + 2) & 1) << 2) | ((i + 2) & 2)) << 19);
+        s32 srcB = (((((i + 1) & 1) << 2) | ((i + 1) & 2)) << 19);
+        std::memcpy(rom.data() + 0x100000 + i * 0x100000, temp.data() + srcA, 0x80000);
+        std::memcpy(rom.data() + 0x180000 + i * 0x100000, temp.data() + 0x080000 + srcB, 0x80000);
+    }
+}
+
+static void pcm2DecryptV(std::vector<u8>& rom, s32 size, s32 bit) {
+    if (static_cast<s32>(rom.size()) < size) {
+        log_error("PCM2 V decrypt needs %d bytes, have %zu", size, rom.size());
+        return;
+    }
+    const s32 group = 2 << bit;
+    for (s32 i = 0; i < (size / 2) - group; i += group) {
+        std::vector<u16> buffer(group);
+        for (s32 j = 0; j < group; j++) buffer[j] = load16(rom.data() + (i + j) * 2);
+        for (s32 j = group - 1; j >= 0; j--) {
+            store16(rom.data() + (i + j) * 2, buffer[j ^ (1 << bit)]);
+        }
+    }
+}
+
+struct Pcm2V2 {
+    s32 addressOffset;
+    s32 addressXor;
+    u8 dataXor[8];
+};
+
+static void pcm2DecryptV2(std::vector<u8>& rom, const Pcm2V2& info) {
+    if (rom.size() < 0x01000000) {
+        log_error("PCM2 V2 decrypt needs 16MB, have %zu", rom.size());
+        return;
+    }
+    std::vector<u8> temp(rom.begin(), rom.begin() + 0x01000000);
+    for (s32 i = 0; i < 0x01000000; i++) {
+        s32 address = ((i & 0x00FEFFFE) | ((i & 0x00010000) >> 16) | ((i & 0x00000001) << 16)) ^ info.addressOffset;
+        rom[address] = temp[(i + info.addressXor) & 0xffffff] ^ info.dataXor[address & 0x07];
+    }
+}
+
+static void mslug3SmaDecrypt(std::vector<u8>& rom) {
+    if (rom.size() < 0x900000) {
+        log_error("mslug3 SMA decrypt needs 9MB, have %zu", rom.size());
+        return;
+    }
+    for (s32 i = 0; i < 0x800000 / 2; i++) {
+        u16 word = load16(rom.data() + 0x100000 + i * 2);
+        word = static_cast<u16>(bitswap16(word, 4, 11, 14, 3, 1, 13, 0, 7, 2, 8, 12, 15, 10, 9, 5, 6));
+        store16(rom.data() + 0x100000 + i * 2, word);
+    }
+    for (s32 i = 0; i < 0x0C0000 / 2; i++) {
+        u32 source = 0x5D0000 / 2 + static_cast<u32>(bitswap24(i, 23, 22, 21, 20, 19, 18, 15, 2, 1, 13, 3, 0, 9, 6, 16, 4, 11, 5, 7, 12, 17, 14, 10, 8));
+        store16(rom.data() + i * 2, load16(rom.data() + source * 2));
+    }
+    for (s32 i = 0; i < 0x800000 / 2; i += 0x010000 / 2) {
+        u16 buffer[0x010000 / 2];
+        for (s32 j = 0; j < 0x010000 / 2; j++) buffer[j] = load16(rom.data() + 0x100000 + (i + j) * 2);
+        for (s32 j = 0; j < 0x010000 / 2; j++) {
+            u32 index = static_cast<u32>(bitswap24(j, 23, 22, 21, 20, 19, 18, 17, 16, 15, 2, 11, 0, 14, 6, 4, 13, 8, 9, 3, 10, 7, 5, 12, 1));
+            store16(rom.data() + 0x100000 + (i + j) * 2, buffer[index]);
+        }
+    }
+}
+
+static void kof2003Callback(std::vector<u8>& rom) {
+    if (rom.size() < 0x900000) {
+        log_error("kof2003 decrypt needs 9MB, have %zu", rom.size());
+        return;
+    }
+    u8* code = rom.data();
+    for (s32 i = 0; i < 0x100000; i++) code[i] ^= ~code[0x0fffe0 + (i & 0x1f)];
+    for (s32 i = 0; i < 0x100000; i++) code[0x800000 + i] ^= code[0x100002 | i];
+    for (s32 i = 0x100000; i < 0x800000; i++) code[i] ^= ~code[0x7fffe0 + (i & 0x1f)];
+    for (s32 i = 0x100000; i < 0x800000; i += 4) {
+        u16 word = readUnaligned16(code + i + 1);
+        word = static_cast<u16>(bitswap16(word, 15, 14, 13, 12, 5, 4, 7, 6, 9, 8, 11, 10, 3, 2, 1, 0));
+        writeUnaligned16(code + i + 1, word);
+    }
+    std::memcpy(code + 0x700000, code, 0x100000);
+    for (s32 i = 0; i < 0x0100000 / 0x10000; i++) {
+        s32 j = static_cast<s32>(bitswap08(i, 7, 6, 5, 4, 0, 1, 2, 3));
+        std::memcpy(code + i * 0x010000, code + 0x700000 + j * 0x010000, 0x010000);
+    }
+    std::memmove(code + 0x200000, code + 0x100000, 0x600000);
+    for (s32 i = 0x200000; i < 0x900000; i += 0x100000) {
+        for (s32 j = 0; j < 0x100000; j += 0x100) {
+            s32 k = (j & 0xf00) ^ 0x00800;
+            k |= static_cast<s32>(bitswap08(j >> 12, 4, 5, 6, 7, 1, 0, 3, 2)) << 12;
+            std::memcpy(code + 0x100000 + j, code + i + k, 0x100);
+        }
+        std::memcpy(code + i, code + 0x100000, 0x100000);
+    }
+}
+
+static void mslug5Callback(std::vector<u8>& rom) {
+    if (rom.size() < 0x800000) {
+        log_error("mslug5 decrypt needs 8MB, have %zu", rom.size());
+        return;
+    }
+    u8* code = rom.data();
+    for (s32 i = 0; i < 0x100000; i++) code[i] ^= code[0x0fffe0 + (i & 0x1f)];
+    for (s32 i = 0x100000; i < 0x700000; i++) code[i] ^= ~code[0x7fffe0 + (i & 0x1f)];
+    for (s32 i = 0x100000; i < 0x0700000; i += 4) {
+        u16 word = readUnaligned16(code + i + 1);
+        word = static_cast<u16>(bitswap16(word, 15, 14, 13, 12, 10, 11, 8, 9, 6, 7, 4, 5, 3, 2, 1, 0));
+        writeUnaligned16(code + i + 1, word);
+    }
+    std::memcpy(code + 0x700000, code, 0x100000);
+    for (s32 i = 0; i < 0x100000 / 0x010000; i++) {
+        s32 j = static_cast<s32>(bitswap08(i, 7, 6, 5, 4, 1, 0, 3, 2)) * 0x010000;
+        std::memcpy(code + i * 0x010000, code + 0x700000 + j, 0x010000);
+    }
+    for (s32 i = 0x100000; i < 0x700000; i += 0x100000) {
+        for (s32 j = 0; j < 0x100000; j += 0x100) {
+            s32 k = ((j & 0xf00) ^ 0x700) + (static_cast<s32>(bitswap08((j >> 12), 5, 4, 7, 6, 1, 0, 3, 2)) << 12);
+            std::memcpy(code + 0x700000 + j, code + i + k, 0x100);
+        }
+        std::memcpy(code + i, code + 0x700000, 0x100000);
+    }
+}
+
+void decryptProtectedProgram(std::string_view set, std::vector<u8>& rom) {
+    if (set == "mslug3") {
+        log_info("SMA decrypt: mslug3");
+        mslug3SmaDecrypt(rom);
+    } else if (set == "kof2002") {
+        log_info("PCM2 P decrypt: kof2002");
+        pcm2DecryptP(rom);
+    } else if (set == "kof2003") {
+        log_info("PVC program decrypt: kof2003");
+        kof2003Callback(rom);
+    } else if (set == "mslug5" || set == "mslug5nd") {
+        log_info("PVC program decrypt: %s", std::string(set).c_str());
+        mslug5Callback(rom);
+    }
+}
+
+void decryptProtectedAdpcm(std::string_view set, std::vector<u8>& rom) {
+    if (set == "kof2002") {
+        log_info("PCM2 V2 decrypt: kof2002");
+        pcm2DecryptV2(rom, { 0xa5000, 0x000000, { 0xf9, 0xe0, 0x5d, 0xf3, 0xea, 0x92, 0xbe, 0xef } });
+    } else if (set == "kof2003") {
+        log_info("PCM2 V2 decrypt: kof2003");
+        pcm2DecryptV2(rom, { 0xa7001, 0xff14ea, { 0x4b, 0xa4, 0x63, 0x46, 0xf0, 0x91, 0xea, 0x62 } });
+    } else if (set == "mslug5") {
+        log_info("PCM2 V2 decrypt: mslug5");
+        pcm2DecryptV2(rom, { 0x4e001, 0xfe2cf6, { 0xc3, 0xfd, 0x81, 0xac, 0x6d, 0xe7, 0xbf, 0x9e } });
+    } else if (set == "mslug4") {
+        log_info("PCM2 V decrypt: mslug4");
+        pcm2DecryptV(rom, 0x1000000, 1);
+    }
+}
+
+} // namespace neogeo
