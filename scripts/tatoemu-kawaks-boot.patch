+void Cartridge::assembleProgram(const std::vector<std::vector<u8>>& parts) {
+    m_programRom.clear();
+    if (parts.empty()) return;
+
+    const bool sma = (m_gameInfo->flags & GAME_FLAG_SMA_PROTECTION) != 0;
+    const bool p32 = (m_gameInfo->flags & GAME_FLAG_P32) != 0;
+    const bool swapp = (m_gameInfo->flags & GAME_FLAG_SWAPP) != 0;
+
+    if (sma) {
+        // SMA chip sits at 0x0C0000. The remaining P ROMs start at 0x100000.
+        // Decrypt later fills 0x000000-0x0C0000 from the scrambled P data.
+        const std::vector<u8>& chip = parts[0];
+        size_t rest = 0;
+        for (size_t i = 1; i < parts.size(); i++) rest += parts[i].size();
+        m_programRom.assign(0x100000 + rest, 0);
+        size_t chipCopy = std::min(chip.size(), static_cast<size_t>(0x40000));
+        std::memcpy(m_programRom.data() + 0x0C0000, chip.data(), chipCopy);
+        size_t offset = 0x100000;
+        for (size_t i = 1; i < parts.size(); i++) {
+            std::memcpy(m_programRom.data() + offset, parts[i].data(), parts[i].size());
+            offset += parts[i].size();
+        }
+        return;
+    }
+
+    if (p32 && parts.size() >= 2 && parts[0].size() == parts[1].size()) {
+        // FBNeo NeoLoadCode P32: gap-2 load, then swap each second word's bytes.
+        // Result is file order [p1_lo, p1_hi, p2_lo, p2_hi, ...] per 16-bit group.
+        const size_t n = parts[0].size();
+        size_t total = n * 2;
+        for (size_t i = 2; i < parts.size(); i++) total += parts[i].size();
+        m_programRom.assign(total, 0);
+        u8* dest = m_programRom.data();
+        const u8* a = parts[0].data();
+        const u8* b = parts[1].data();
+        for (size_t i = 0; i < n; i++) {
+            dest[i * 2] = a[i];
+            dest[i * 2 + 1] = b[i];
+        }
+        for (size_t j = 0; j + 3 < n * 2; j += 4) {
+            std::swap(dest[j + 1], dest[j + 2]);
+        }
+        size_t offset = n * 2;
+        for (size_t i = 2; i < parts.size(); i++) {
+            std::memcpy(dest + offset, parts[i].data(), parts[i].size());
+            offset += parts[i].size();
+        }
+        return;
+    }
+
+    for (size_t i = 0; i < parts.size(); i++) {
+        std::vector<u8> romData = parts[i];
+        if (swapp && i == 0 && romData.size() >= 2) {
+            size_t half = romData.size() / 2;
+            for (size_t j = 0; j < half; j++) std::swap(romData[j], romData[j + half]);
+        }
+        m_programRom.insert(m_programRom.end(), romData.begin(), romData.end());
+    }
+}
+
+void Cartridge::decryptCmcSprites() {
+    const s32 romSize = static_cast<s32>(m_spriteRom.size());
+    if (romSize <= 0) return;
+    std::vector<u8> source = std::move(m_spriteRom);
+    m_spriteRom.assign(source.size(), 0);
+    std::vector<u8> chunk(0x400000);
+    const u8 extra = static_cast<u8>(cmcProtectionXor() & 0xff);
+    for (s32 offset = 0; offset < romSize && offset < 0x04000000; offset += 0x400000) {
+        const s32 count = std::min<s32>(0x400000, romSize - offset);
+        std::fill(chunk.begin(), chunk.end(), 0);
+        std::memcpy(chunk.data(), source.data() + offset, static_cast<size_t>(count));
+        cmcDecrypt(extra, m_spriteRom.data(), chunk.data(), offset, 0x400000, romSize);
+    }
+}
+
