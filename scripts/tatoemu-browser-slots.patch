+void Emulator::setPaused(bool paused) {
+    if (m_paused == paused) return;
+    m_paused = paused;
+    if (m_paused && m_audioDevice) {
+        m_audioDevice->clearBuffer();
+    }
+}
+
+bool Emulator::quickSaveState() {
+    if (m_romFilename.empty() || !m_core) return false;
+    fs::path savePath = m_romFilename;
+    savePath.replace_extension(".state");
+    if (!m_core->saveState(savePath)) return false;
+    log_info("State saved to %s", savePath.string().c_str());
+    return true;
+}
+
+bool Emulator::quickLoadState() {
+    if (m_romFilename.empty() || !m_core) return false;
+    fs::path savePath = m_romFilename;
+    savePath.replace_extension(".state");
+    if (!m_core->loadState(savePath)) return false;
+    if (m_audioDevice) {
+        m_audioDevice->clearBuffer();
+    }
+    log_info("State loaded from %s", savePath.string().c_str());
+    return true;
+}
